rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is a teacher
    function isTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper: check if the teacher owns a class
    function isClassOwner(classId) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherID == request.auth.uid;
    }

    // Helper: check if the teacher owns the class an assignment belongs to.
    // Used for /assignments writes so a teacher cannot edit another teacher's
    // assignments even after authenticating (ISSUE-013).
    function isAssignmentOwner(assignmentId) {
      return isTeacher()
        && isClassOwner(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classID);
    }

    // ────────────────────────────────────────────────
    // Users (teacher profiles)
    // ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId;
    }

    // ────────────────────────────────────────────────
    // Classes
    // ────────────────────────────────────────────────
    match /classes/{classId} {
      // Teachers can create classes (teacherID must match auth uid)
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      // Teachers can update/delete their own classes
      allow update, delete: if isClassOwner(classId);
      // Intentionally public: students don't use Firebase Auth and need to
      // look up classes by their MX-XXXX code. Security comes from the code
      // being hard to guess. Do NOT add `request.auth != null || true` —
      // the `|| true` makes the auth check meaningless and is misleading.
      allow read: if true;

      // Students subcollection
      match /students/{studentId} {
        allow read: if true; // Students need to see the name list
        allow write: if isClassOwner(classId);
        // Allow device token update from any source (student iPad)
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deviceToken']);
      }

      // Chapters subcollection
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isClassOwner(classId);

        // Competencies subcollection
        match /competencies/{competencyId} {
          allow read: if true;
          allow write: if isClassOwner(classId);
        }
      }

      // Groups subcollection (named subsets of students within a class)
      match /groups/{groupId} {
        allow read: if true; // Students need to know their own group
        allow write: if isClassOwner(classId);
      }
    }

    // ────────────────────────────────────────────────
    // Exercises (top-level, owned by teachers)
    // ────────────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if true; // Students need to read assigned exercises
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherID == request.auth.uid;
    }

    // ────────────────────────────────────────────────
    // Assignments (top-level)
    // ────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if true; // Students need to read their assignments
      // Create: must own the target class (ISSUE-013 — previously any teacher
      // could create assignments under any class).
      allow create: if isTeacher()
        && isClassOwner(request.resource.data.classID);
      // Update/delete: must own the existing assignment's class.
      allow update, delete: if isAssignmentOwner(assignmentId);

      // Assignment exercises subcollection — gate on the parent assignment's
      // owner so only that teacher can mutate the exercise roster.
      match /exercises/{aeId} {
        allow read: if true;
        allow write: if isAssignmentOwner(assignmentId);
      }
    }

    // ────────────────────────────────────────────────
    // Levels-mode progress (per student per assignment)
    // ────────────────────────────────────────────────
    // Stored under classes/{classId}/students/{studentId}/levelProgress/{assignmentId}.
    // Open to public read/write because students have no Firebase Auth — same
    // posture as /submissions.
    match /classes/{classId}/students/{studentId}/levelProgress/{assignmentId} {
      allow read: if true;
      allow write: if true;
    }

    // ────────────────────────────────────────────────
    // Periods (top-level — group of timed sessions for a class)
    // ────────────────────────────────────────────────
    function isPeriodOwner(periodId) {
      return isTeacher()
        && isClassOwner(get(/databases/$(database)/documents/periods/$(periodId)).data.classID);
    }

    match /periods/{periodId} {
      allow read: if true; // Students need their assigned periods
      allow create: if isTeacher()
        && isClassOwner(request.resource.data.classID);
      allow update, delete: if isPeriodOwner(periodId);

      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isPeriodOwner(periodId);

        match /exercises/{aeId} {
          allow read: if true;
          allow write: if isPeriodOwner(periodId);
        }
      }
    }

    // ────────────────────────────────────────────────
    // Submissions (top-level)
    // ────────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Submissions are still creatable without auth (students have no
      // Firebase Auth) but reads now require either a teacher or a
      // matching `studentID` claim from the device token check.
      // For MVP-launch safety we read-allow only if request claims a
      // matching studentID via a `X-Mathclass-Student-Token` header
      // (forwarded by the SDK via `request.auth.token`); fall back to
      // teachers otherwise. Server-side correction writes via the
      // Admin SDK bypass these rules.
      allow read: if isTeacher()
        || (request.auth != null && resource.data.studentID == request.auth.uid);
      allow create: if true;
      allow update: if isTeacher();
    }
  }
}
