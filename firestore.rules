rules_version = '2';

// Who can see what
// ─────────────────
// • Teachers: Firebase Auth email/password accounts with users/{uid}.role
//   == 'teacher'. A teacher only reaches the classes they own and
//   everything hanging off them.
// • Students: Firebase Auth *anonymous* accounts. After a valid class code +
//   name pick, the `claim_student_seat` Cloud Function stamps them with the
//   custom claims {role: 'student', classID, studentID}. A student only
//   reaches their own class's content and their own work.
// • Nobody else reads anything. The class-code lookup and the name picker
//   go through the `join_class` Cloud Function (Admin SDK), so classes are
//   not publicly listable.
// • Correction results are written by the `correct_submission` Cloud
//   Function (Admin SDK, bypasses these rules), never by clients.
//
// Tested by firestore-tests/ against the emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ─────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTeacher() {
      return signedIn()
        && !isAnonymous()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return signedIn()
        && request.auth.token.get('role', '') == 'student'
        && request.auth.token.get('classID', '') != ''
        && request.auth.token.get('studentID', '') != '';
    }

    function studentClassID() {
      return request.auth.token.classID;
    }

    function studentID() {
      return request.auth.token.studentID;
    }

    function isStudentOf(classId) {
      return isStudent() && studentClassID() == classId;
    }

    function isThisStudent(classId, sid) {
      return isStudentOf(classId) && studentID() == sid;
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function ownsClass(classId) {
      return isTeacher() && classData(classId).teacherID == request.auth.uid;
    }

    // Owner teacher or a student of the class.
    function inClass(classId) {
      return ownsClass(classId) || isStudentOf(classId);
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ── Users (teacher profiles) ─────────────────────

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Self sign-up as a teacher. Anonymous (student) accounts can't.
      allow create: if signedIn()
        && !isAnonymous()
        && request.auth.uid == userId
        && request.resource.data.role == 'teacher';
      allow update: if signedIn()
        && request.auth.uid == userId
        && unchanged('role');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ── Classes ──────────────────────────────────────

    match /classes/{classId} {
      // `resource.data.teacherID == uid` (rather than ownsClass) keeps the
      // teacher's `where teacherID == uid` listener provable.
      allow read: if (isTeacher() && resource.data.teacherID == request.auth.uid)
        || isStudentOf(classId);
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      allow update: if ownsClass(classId) && unchanged('teacherID');
      allow delete: if ownsClass(classId);

      match /students/{sid} {
        // Classmates' names are not readable by students: the name picker
        // comes from `join_class`, with last-name initials only.
        allow read: if ownsClass(classId) || isThisStudent(classId, sid);
        allow create, delete: if ownsClass(classId);
        allow update: if ownsClass(classId)
          || (isThisStudent(classId, sid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceToken']));

        // Levels-mode progress (per student per assignment).
        match /levelProgress/{assignmentId} {
          allow read: if ownsClass(classId) || isThisStudent(classId, sid);
          allow write: if isThisStudent(classId, sid);
        }
      }

      match /chapters/{chapterId} {
        allow read: if inClass(classId);
        allow write: if ownsClass(classId);

        match /competencies/{competencyId} {
          allow read: if inClass(classId);
          allow write: if ownsClass(classId);
        }
      }

      match /groups/{groupId} {
        allow read: if inClass(classId);
        allow write: if ownsClass(classId);
      }
    }

    // ── Exercises (teacher library) ──────────────────
    // Exercise content is not personal data, and the student side loads
    // exercises by ID across teachers' libraries, so any teacher or
    // student can read. Only the author edits.

    match /exercises/{exerciseId} {
      allow read: if isTeacher() || isStudent();
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.teacherID == request.auth.uid
        && unchanged('teacherID');
      allow delete: if isTeacher()
        && resource.data.teacherID == request.auth.uid;
    }

    // ── Assignments (legacy, still used by the student app) ──

    function assignmentClassID(assignmentId) {
      return get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classID;
    }

    match /assignments/{assignmentId} {
      allow read: if inClass(resource.data.classID);
      allow create: if ownsClass(request.resource.data.classID);
      allow update: if ownsClass(resource.data.classID) && unchanged('classID');
      allow delete: if ownsClass(resource.data.classID);

      match /exercises/{aeId} {
        allow read: if inClass(assignmentClassID(assignmentId));
        allow write: if ownsClass(assignmentClassID(assignmentId));
      }
    }

    // ── Periods → sessions → exercises ───────────────

    function periodClassID(periodId) {
      return get(/databases/$(database)/documents/periods/$(periodId)).data.classID;
    }

    match /periods/{periodId} {
      allow read: if inClass(resource.data.classID);
      allow create: if ownsClass(request.resource.data.classID);
      allow update: if ownsClass(resource.data.classID) && unchanged('classID');
      allow delete: if ownsClass(resource.data.classID);

      match /sessions/{sessionId} {
        allow read: if inClass(periodClassID(periodId));
        allow write: if ownsClass(periodClassID(periodId));

        match /exercises/{aeId} {
          allow read: if inClass(periodClassID(periodId));
          allow write: if ownsClass(periodClassID(periodId));
        }
      }
    }

    // ── Submissions ──────────────────────────────────
    // Each submission carries `classID` and `teacherID` (copied from the
    // class at creation and checked here), so both sides' queries are
    // provable: teachers always filter on `teacherID == uid`, students on
    // `studentID == <their claim>`.

    match /submissions/{submissionId} {
      allow read: if (isTeacher() && resource.data.teacherID == request.auth.uid)
        || (isStudent() && resource.data.studentID == studentID());

      allow create: if isStudent()
        && request.resource.data.studentID == studentID()
        && request.resource.data.classID == studentClassID()
        && request.resource.data.teacherID == classData(studentClassID()).teacherID
        // Grading is server-side only.
        && !('correctionResult' in request.resource.data)
        && !('finalResult' in request.resource.data);

      // Teachers may annotate their own class's submissions but not move
      // them to another student, class or teacher.
      allow update: if isTeacher()
        && resource.data.teacherID == request.auth.uid
        && unchanged('teacherID')
        && unchanged('classID')
        && unchanged('studentID');
      allow delete: if false;
    }

    // Everything else is closed.
  }
}
