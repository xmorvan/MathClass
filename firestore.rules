rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is a teacher
    function isTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper: check if the teacher owns a class
    function isClassOwner(classId) {
      return isTeacher()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherID == request.auth.uid;
    }

    // ────────────────────────────────────────────────
    // Users (teacher profiles)
    // ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId;
    }

    // ────────────────────────────────────────────────
    // Classes
    // ────────────────────────────────────────────────
    match /classes/{classId} {
      // Teachers can create classes (teacherID must match auth uid)
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      // Teachers can update/delete their own classes
      allow update, delete: if isClassOwner(classId);
      // Intentionally public: students don't use Firebase Auth and need to
      // look up classes by their MX-XXXX code. Security comes from the code
      // being hard to guess. Do NOT add `request.auth != null || true` —
      // the `|| true` makes the auth check meaningless and is misleading.
      allow read: if true;

      // Students subcollection
      match /students/{studentId} {
        allow read: if true; // Students need to see the name list
        allow write: if isClassOwner(classId);
        // Allow device token update from any source (student iPad)
        allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deviceToken']);
      }

      // Chapters subcollection
      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isClassOwner(classId);

        // Competencies subcollection
        match /competencies/{competencyId} {
          allow read: if true;
          allow write: if isClassOwner(classId);
        }
      }
    }

    // ────────────────────────────────────────────────
    // Exercises (top-level, owned by teachers)
    // ────────────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if true; // Students need to read assigned exercises
      allow create: if isTeacher()
        && request.resource.data.teacherID == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherID == request.auth.uid;
    }

    // ────────────────────────────────────────────────
    // Assignments (top-level)
    // ────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if true; // Students need to read their assignments
      allow create: if isTeacher();
      allow update, delete: if isTeacher();

      // Assignment exercises subcollection
      match /exercises/{aeId} {
        allow read: if true;
        allow write: if isTeacher();
      }
    }

    // ────────────────────────────────────────────────
    // Submissions (top-level)
    // ────────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Intentionally public read: students (no Auth) need to read their
      // own submission after correction, and teachers need full access.
      // Tighten later with a per-device token check.
      allow read: if true;
      // Anyone can create a submission (students don't have Firebase Auth)
      allow create: if true;
      // Only teachers can update (correction results are written by the
      // iOS client via CorrectionService.correctAndUpdate, signed in as
      // a teacher OR through the Cloud Function which uses Admin SDK and
      // bypasses these rules entirely).
      allow update: if isTeacher();
    }
  }
}
