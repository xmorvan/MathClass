rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Exercise images — teachers upload, anyone can read
    match /exercises/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Student submissions — students have no Firebase Auth, so writes are
    // public, but scoped to a single file per student/exercise path with
    // strict size and content-type guards to make abuse painful.
    match /submissions/{studentID}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*');
    }
  }
}
