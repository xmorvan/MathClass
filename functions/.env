# Non-secret configuration read by Cloud Functions at deploy time.
# Claude runs on Google Cloud Vertex AI in Europe (see claude_client.py and
# docs/legal/). Set CLAUDE_PROVIDER=anthropic to use the Anthropic API
# directly instead (data processed in the United States).
CLAUDE_PROVIDER=vertex
CLAUDE_VERTEX_REGION=europe-west1
CLAUDE_MODEL=claude-haiku-4-5
