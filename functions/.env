# Non-secret configuration read by Cloud Functions at deploy time.
# Claude runs on Google Cloud Vertex AI in Europe (see claude_client.py and
# docs/legal/). Set CLAUDE_PROVIDER=anthropic to use the Anthropic API
# directly instead (data processed in the United States).
# TEMPORAIRE (25.09.2026) : Vertex AI refuse le quota tant que le compte de
# facturation a moins de 48 h. Tests internes uniquement, sans vrais élèves.
# Remettre CLAUDE_PROVIDER=vertex dès que le quota europe-west1 est accordé.
CLAUDE_PROVIDER=anthropic
CLAUDE_VERTEX_REGION=europe-west1
# CLAUDE_MODEL=claude-haiku-4-5  (nom Vertex ; le défaut du fournisseur anthropic est claude-haiku-4-5-20251001)
